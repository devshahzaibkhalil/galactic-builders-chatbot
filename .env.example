FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=
DATABASE_URL=sqlite:///galactic_builders_dev.db
REDIS_URL=

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
BACKUP_ENCRYPTION_KEY=

ALLOWED_ORIGINS=https://galacticbuilldersllc.com,https://www.galacticbuilldersllc.com
ALLOWED_FRAME_ANCESTORS=https://galacticbuilldersllc.com,https://www.galacticbuilldersllc.com

# Email is sent over the Mailjet HTTPS API, not SMTP, because Render blocks
# outbound SMTP ports 25/465/587. Mailjet verifies a single SENDER ADDRESS by
# emailing a confirmation link to it, so no domain DNS access is required.
#   1. Sign up at https://www.mailjet.com (free tier: 6000 emails/month).
#   2. Senders & Domains -> Add a sender address. Enter the address mail should
#      come FROM, then click the confirmation link sent to that inbox.
#   3. Account Settings -> API Key Management. Mailjet issues TWO values, an
#      API Key and a Secret Key. BOTH are required or every send returns 401.
# Do NOT wrap any of these values in quotes.
EMAIL_PROVIDER=mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
EMAIL_FROM_NAME=Galactic Builders
EMAIL_FROM_ADDRESS=

# Raw SMTP is still supported for local development or self-hosting outside
# Render. To use it, set EMAIL_PROVIDER=smtp and fill these in instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# Default recipient for new-lead/new-conversation/appointment emails.
# A superadmin can override this at any time from Admin Dashboard -> Settings
# -> Lead notifications, without redeploying; that override always wins over
# this env var. Leave this set as a sane fallback for fresh deployments.
LEAD_NOTIFICATION_EMAIL=
LEAD_NOTIFICATION_CC=
LEAD_REPLY_TO_EMAIL=

MAX_UPLOAD_MB=10
MAX_FILES_PER_LEAD=8
MAX_TOTAL_UPLOAD_MB=40

LEAD_RETENTION_DAYS=730
CONVERSATION_RETENTION_DAYS=365
SECURITY_LOG_RETENTION_DAYS=730
FAILED_UPLOAD_RETENTION_DAYS=7
