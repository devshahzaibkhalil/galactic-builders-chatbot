FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=
DATABASE_URL=sqlite:///galactic_builders_dev.db
REDIS_URL=

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
BACKUP_ENCRYPTION_KEY=

ALLOWED_ORIGINS=https://galacticbuilldersllc.com,https://www.galacticbuilldersllc.com
ALLOWED_FRAME_ANCESTORS=https://galacticbuilldersllc.com,https://www.galacticbuilldersllc.com

EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_NAME=Galactic Builders
EMAIL_FROM_ADDRESS=
LEAD_NOTIFICATION_EMAIL=
LEAD_NOTIFICATION_CC=
LEAD_REPLY_TO_EMAIL=

MAX_UPLOAD_MB=10
MAX_FILES_PER_LEAD=8
MAX_TOTAL_UPLOAD_MB=40

LEAD_RETENTION_DAYS=730
CONVERSATION_RETENTION_DAYS=365
SECURITY_LOG_RETENTION_DAYS=730
FAILED_UPLOAD_RETENTION_DAYS=7
